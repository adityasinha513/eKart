{
  "expo": {
    "platforms": ["android"],
    "name": "Mithai Junction",
    "slug": "mithai-junction",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.mithaijunction.shop",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "Use your location to check delivery availability within 20 km." }],
      "expo-secure-store"
    ]
  }
}
